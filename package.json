{
  "name": "agent-office",
  "version": "0.1.1",
  "productName": "Agent Office",
  "description": "Claude Code / Codex 세션을 아이소메트릭 사무실로 실시간 시각화하는 로컬 대시보드",
  "type": "module",
  "main": "electron-main.mjs",
  "bin": {
    "agent-office": "agent-office.mjs"
  },
  "scripts": {
    "start": "node agent-office.mjs",
    "desktop": "electron .",
    "check": "node --check agent-office.mjs && node --check electron-main.mjs && node --check forge.config.cjs && node --check scripts/build-icon.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "package:desktop": "electron-forge package",
    "make": "electron-forge make"
  },
  "files": [
    "agent-office.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "dashboard",
    "visualization",
    "isometric"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "45.2.3"
  },
  "allowScripts": {
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  }
}
